# Copy to .env and fill in values.
# Sample mailbox, no Azure credentials:  python -m controller_inbox demo --serve
# Laptop drop folder: put .msg/.eml files in inbox/incoming, then double-click CloseDesk (or python -m controller_inbox run)

# Where SQLite, digest files, and the token cache live
CONTROLLER_INBOX_DATA_DIR=./data

# Drop folder for .msg / .eml and related attachments
CONTROLLER_INBOX_INBOX_DIR=./inbox

# IANA timezone used for "today", due dates, and the daily digest
CONTROLLER_INBOX_TIMEZONE=America/New_York

# Local dashboard
CONTROLLER_INBOX_HOST=127.0.0.1
CONTROLLER_INBOX_PORT=8765

# Polling
CONTROLLER_INBOX_POLL_SECONDS=120
CONTROLLER_INBOX_LOOKBACK_HOURS=72

# Flag invoices/wires at or above this USD amount as high importance
CONTROLLER_INBOX_HIGH_AMOUNT=10000

# Optional: comma-separated VIP sender emails or domains (boosts importance)
# CONTROLLER_INBOX_VIP_SENDERS=cfo@yourco.com,auditor@big4.com,irs.gov

# Write categories + follow-up flag back to Outlook (requires Mail.ReadWrite)
CONTROLLER_INBOX_WRITEBACK=false

# Daily digest local hour (0-23) used by `watch`
CONTROLLER_INBOX_DIGEST_HOUR=7

# Optional: send the digest as email via Graph (requires Mail.Send)
# CONTROLLER_INBOX_DIGEST_TO=you@yourco.com

# --- Microsoft Graph (leave blank to stay in demo mode) ---
# Entra app registration: public client + device code is the usual desktop setup.
AZURE_CLIENT_ID=
AZURE_TENANT_ID=common

# Confidential-client / daemon mode (application permissions). Also set MAILBOX_UPN.
# AZURE_CLIENT_SECRET=
# CONTROLLER_INBOX_MAILBOX=controller@yourco.com

# Local model in LM Studio (Bionic) or Ollama. Scripts still extract text, amounts, dates, and fraud signals.
# auto (default): use a model whenever the server has one loaded. true: always try. false: never.
# CONTROLLER_INBOX_LLM=auto
# CONTROLLER_INBOX_LLM_BASE_URL=http://127.0.0.1:1234/v1
# Ollama: CONTROLLER_INBOX_LLM_BASE_URL=http://127.0.0.1:11434/v1
# local-model means "whatever LM Studio has loaded". Set an id to pin one.
# CONTROLLER_INBOX_LLM_MODEL=local-model
# Only if your local server requires a key:
# CONTROLLER_INBOX_LLM_API_KEY=
# Small-model limits: packet size in characters, reply length, and seconds to wait per message.
# CONTROLLER_INBOX_LLM_MAX_PROMPT_CHARS=6000
# CONTROLLER_INBOX_LLM_MAX_TOKENS=450
# CONTROLLER_INBOX_LLM_TIMEOUT=90
# How many drafts one run sends to the model (most important first).
# CONTROLLER_INBOX_OVERNIGHT_BATCH=40

# Digest window: mail since the start of the previous working day. Raise to look further back.
# CONTROLLER_INBOX_DIGEST_LOOKBACK_DAYS=1
# OPENAI_API_KEY=
